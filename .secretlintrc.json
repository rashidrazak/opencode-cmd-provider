{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Command Code API key",
            "patterns": ["/\\b(?:user|cc)_[A-Za-z0-9_-]{8,}\\b/g"],
            "allows": ["user_abcdefgh1234", "user_abc12345", "user_nomirror", "cc_abcdefgh1234"]
          }
        ]
      }
    }
  ]
}
