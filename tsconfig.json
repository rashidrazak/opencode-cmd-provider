{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "types": ["node"]
  },
  "include": ["index.ts", "tui.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["tests", "scripts", "dist"]
}
